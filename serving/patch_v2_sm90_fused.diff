@@ -79,6 +79,30 @@ def fused_post_expert_norm_weighted_sum(
     round_product preserves input-dtype multiplication before FP32 accumulation
     when combining an already normalized low-precision tensor.
     """
+    if expert_output.dim() == 3 and expert_output.shape[0] > 0:
+        from sglang.kernels.ops.moe.muse_spark_post_expert_finalize_jit import (
+            fused_post_expert_norm_weighted_sum_jit,
+            is_jit_eligible,
+        )
+
+        if is_jit_eligible(
+            expert_output,
+            topk_scores,
+            norm_weight=norm_weight,
+            apply_norm=apply_norm,
+            slot_expert_ids=slot_expert_ids,
+        ):
+            return fused_post_expert_norm_weighted_sum_jit(
+                expert_output,
+                topk_scores,
+                norm_weight=norm_weight,
+                eps=eps,
+                weight_first=weight_first,
+                apply_norm=apply_norm,
+                slot_expert_ids=slot_expert_ids,
+                round_product=round_product,
+            )
+
     x = expert_output.contiguous()
     tokens, topk, hidden = x.shape
     out = torch.empty((tokens, hidden), dtype=x.dtype, device=x.device)
