+++ b/python/sglang/kernels/jit/csrc/muse_spark/post_expert_finalize.cuh
@@ -0,0 +1,293 @@
+/**
+ * \brief Fused post-expert RMSNorm + active-slot weighted combine for MuseSpark MoE.
+ *
+ * Replaces the multi-pass Triton / PyTorch finalize with a single-pass CTA kernel
+ * (1 block per token) featuring Programmatic Dependent Launch (PDL), early warp
+ * ballot over active slots (skipping inactive padded/remote HBM reads and fast
+ * zeroing empty tokens), register-resident normalization, and SM90-friendly
+ * 16-byte vectorized BF16 memory traffic.
+ */
+
+#pragma once
+
+#include <sgl_kernel/tensor.h>
+#include <sgl_kernel/utils.h>
+
+#include <sgl_kernel/cta.cuh>
+#include <sgl_kernel/math.cuh>
+#include <sgl_kernel/type.cuh>
+#include <sgl_kernel/utils.cuh>
+#include <sgl_kernel/vec.cuh>
+#include <sgl_kernel/warp.cuh>
+
+#include <tvm/ffi/container/tensor.h>
+#include <tvm/ffi/optional.h>
+
+#include <cstdint>
+
+namespace sglang {
+
+namespace muse_spark {
+
+struct PostExpertFinalizeParams {
+  const void* __restrict__ expert_output;
+  const void* __restrict__ norm_weight;
+  const void* __restrict__ topk_scores;
+  void* __restrict__ out;
+  const int32_t* __restrict__ slot_expert_ids;
+  float eps;
+  int num_tokens;
+  bool scores_bf16;
+  bool round_product;
+};
+
+// kNormMode:
+//   0: no norm (y = x)
+//   1: apply_norm, no norm_weight (y = rms_norm(x))
+//   2: apply_norm, weight second (y = rms_norm(x) * w)
+//   3: apply_norm, weight first (y = rms_norm(w * x))
+template <int64_t kHidden, int kNumThreads, int kTopK, int kNormMode, bool kUsePDL>
+__global__ void __launch_bounds__(kNumThreads)
+    post_expert_finalize_kernel(const __grid_constant__ PostExpertFinalizeParams params) {
+  constexpr int kVec = 8;
+  constexpr int kPairs = kVec / 2;
+  constexpr int kPacks = static_cast<int>(kHidden / (kNumThreads * kVec));
+  constexpr int kNumWarps = kNumThreads / static_cast<int>(device::kWarpThreads);
+  constexpr bool kApplyNorm = (kNormMode != 0);
+  constexpr bool kHasWeight = (kNormMode >= 2);
+  constexpr bool kWeightFirst = (kNormMode == 3);
+  constexpr int kSmemSlots = (kApplyNorm && kNumWarps > 1) ? kNumWarps : 1;
+
+  static_assert(kHidden > 0 && kHidden % (kNumThreads * kVec) == 0);
+  static_assert(kNumThreads % device::kWarpThreads == 0 && kNumThreads <= 1024);
+  static_assert(kTopK >= 1 && kTopK <= 32);
+  static_assert(kNormMode >= 0 && kNormMode <= 3);
+
+  using BF16Vec = device::AlignedVector<bf16x2_t, kPairs>;
+
+  const int tok = static_cast<int>(blockIdx.x);
+  if (tok >= params.num_tokens) return;
+
+  const uint32_t lane = device::get_lane_id();
+  const int64_t tok_topk = static_cast<int64_t>(tok) * kTopK;
+  const int64_t out_base = static_cast<int64_t>(tok) * kHidden;
+  auto* __restrict__ out_ptr = static_cast<bf16_t*>(params.out) + out_base;
+
+  // Order reads against the upstream Marlin/scatter GEMM2 kernel on this stream.
+  device::PDLWaitPrimary<kUsePDL>();
+
+  uint32_t live_mask = (kTopK == 32) ? device::warp::kFullMask : ((1u << kTopK) - 1u);
+  if (params.slot_expert_ids != nullptr) {
+    const bool ok = (lane < static_cast<uint32_t>(kTopK)) &&
+                    (params.slot_expert_ids[tok_topk + lane] >= 0);
+    live_mask = __ballot_sync(device::warp::kFullMask, ok);
+  }
+
+  if (live_mask == 0u) {
+    BF16Vec zero_vec;
+    zero_vec.fill(device::cast<bf16x2_t>(make_float2(0.0f, 0.0f)));
+#pragma unroll
+    for (int p = 0; p < kPacks; ++p) {
+      zero_vec.store(out_ptr, threadIdx.x + p * kNumThreads);
+    }
+    device::PDLTriggerSecondary<kUsePDL>();
+    return;
+  }
+
+  float my_score = 0.0f;
+  if ((live_mask >> lane) & 1u) {
+    if (params.scores_bf16) {
+      const auto s_bf16 = static_cast<const bf16_t*>(params.topk_scores)[tok_topk + lane];
+      my_score = device::cast<fp32_t>(s_bf16);
+    } else {
+      my_score = static_cast<const float*>(params.topk_scores)[tok_topk + lane];
+    }
+  }
+
+  BF16Vec w_vec[kHasWeight ? kPacks : 1];
+  if constexpr (kHasWeight) {
+    const auto* __restrict__ w_ptr = static_cast<const bf16_t*>(params.norm_weight);
+#pragma unroll
+    for (int p = 0; p < kPacks; ++p) {
+      w_vec[p].load(w_ptr, threadIdx.x + p * kNumThreads);
+    }
+  }
+
+  fp32x2_t acc[kPacks][kPairs];
+#pragma unroll
+  for (int p = 0; p < kPacks; ++p) {
+#pragma unroll
+    for (int q = 0; q < kPairs; ++q) {
+      acc[p][q] = make_float2(0.0f, 0.0f);
+    }
+  }
+
+  // Two ping-pong buffers avoid an extra trailing barrier after cta::reduce_sum:
+  // iteration m+2 cannot overwrite smem_red[m%2] before passing the m+1 barrier.
+  __shared__ float smem_red[2][kSmemSlots];
+  int parity = 0;
+
+  uint32_t rem = live_mask;
+  while (rem != 0u) {
+    const int k = __ffs(static_cast<int>(rem)) - 1;
+    rem &= rem - 1u;
+    const float s = __shfl_sync(device::warp::kFullMask, my_score, k);
+    const int64_t slot_base = (tok_topk + k) * kHidden;
+    const auto* __restrict__ x_ptr = static_cast<const bf16_t*>(params.expert_output) + slot_base;
+
+    if constexpr (!kApplyNorm) {
+#pragma unroll
+      for (int p = 0; p < kPacks; ++p) {
+        BF16Vec x_vec;
+        x_vec.load(x_ptr, threadIdx.x + p * kNumThreads);
+#pragma unroll
+        for (int q = 0; q < kPairs; ++q) {
+          const fp32x2_t y = device::cast<fp32x2_t>(x_vec[q]);
+          fp32x2_t prod = make_float2(y.x * s, y.y * s);
+          if (params.round_product) {
+            prod = device::cast<fp32x2_t>(device::cast<bf16x2_t>(prod));
+          }
+          acc[p][q].x += prod.x;
+          acc[p][q].y += prod.y;
+        }
+      }
+    } else {
+      fp32x2_t row_vals[kPacks][kPairs];
+      float sum_sq = 0.0f;
+#pragma unroll
+      for (int p = 0; p < kPacks; ++p) {
+        BF16Vec x_vec;
+        x_vec.load(x_ptr, threadIdx.x + p * kNumThreads);
+#pragma unroll
+        for (int q = 0; q < kPairs; ++q) {
+          fp32x2_t v = device::cast<fp32x2_t>(x_vec[q]);
+          if constexpr (kHasWeight && kWeightFirst) {
+            const fp32x2_t w = device::cast<fp32x2_t>(w_vec[p][q]);
+            v.x *= w.x;
+            v.y *= w.y;
+          }
+          row_vals[p][q] = v;
+          sum_sq = fmaf(v.x, v.x, sum_sq);
+          sum_sq = fmaf(v.y, v.y, sum_sq);
+        }
+      }
+
+      sum_sq = device::cta::reduce_sum<kNumThreads>(sum_sq, smem_red[parity]);
+      parity ^= 1;
+      const float rstd = device::math::rsqrt(sum_sq / static_cast<float>(kHidden) + params.eps);
+
+#pragma unroll
+      for (int p = 0; p < kPacks; ++p) {
+#pragma unroll
+        for (int q = 0; q < kPairs; ++q) {
+          fp32x2_t y = make_float2(row_vals[p][q].x * rstd, row_vals[p][q].y * rstd);
+          if constexpr (kHasWeight && !kWeightFirst) {
+            const fp32x2_t w = device::cast<fp32x2_t>(w_vec[p][q]);
+            y.x *= w.x;
+            y.y *= w.y;
+          }
+          fp32x2_t prod = make_float2(y.x * s, y.y * s);
+          if (params.round_product) {
+            prod = device::cast<fp32x2_t>(device::cast<bf16x2_t>(prod));
+          }
+          acc[p][q].x += prod.x;
+          acc[p][q].y += prod.y;
+        }
+      }
+    }
+  }
+
+#pragma unroll
+  for (int p = 0; p < kPacks; ++p) {
+    BF16Vec out_vec;
+#pragma unroll
+    for (int q = 0; q < kPairs; ++q) {
+      out_vec[q] = device::cast<bf16x2_t>(acc[p][q]);
+    }
+    out_vec.store(out_ptr, threadIdx.x + p * kNumThreads);
+  }
+  device::PDLTriggerSecondary<kUsePDL>();
+}
+
+}  // namespace muse_spark
+
+template <int64_t kHidden, int kNumThreads, int kTopK, int kNormMode, bool kUsePDL>
+void fused_post_expert_norm_weighted_sum(
+    const tvm::ffi::TensorView expert_output,
+    const tvm::ffi::TensorView topk_scores,
+    const tvm::ffi::TensorView out,
+    const tvm::ffi::Optional<tvm::ffi::TensorView> norm_weight,
+    const tvm::ffi::Optional<tvm::ffi::TensorView> slot_expert_ids,
+    double eps,
+    bool round_product) {
+  using namespace host;
+
+  auto T = SymbolicSize{"num_tokens"};
+  auto K = SymbolicSize{"topk"};
+  auto H = SymbolicSize{"hidden_size"};
+  auto dev = SymbolicDevice{};
+  K.set_value(kTopK);
+  H.set_value(kHidden);
+  dev.set_options<kDLCUDA>();
+
+  TensorMatcher({T, K, H})
+      .with_dtype<bf16_t>()
+      .with_device<kDLCUDA>(dev)
+      .ensure_alignment(16)
+      .verify(expert_output);
+  TensorMatcher({T, K})
+      .with_dtype<fp32_t, bf16_t>()
+      .with_device<kDLCUDA>(dev)
+      .verify(topk_scores);
+  TensorMatcher({T, H})
+      .with_dtype<bf16_t>()
+      .with_device<kDLCUDA>(dev)
+      .ensure_alignment(16)
+      .verify(out);
+
+  if constexpr (kNormMode >= 2) {
+    RuntimeCheck(norm_weight.has_value(), "norm_weight is required for kNormMode >= 2");
+    TensorMatcher({H})
+        .with_dtype<bf16_t>()
+        .with_device<kDLCUDA>(dev)
+        .ensure_alignment(16)
+        .verify(norm_weight.value());
+  } else {
+    RuntimeCheck(!norm_weight.has_value(), "norm_weight must be null for kNormMode < 2");
+  }
+
+  if (slot_expert_ids.has_value()) {
+    TensorMatcher({T, K})
+        .with_dtype<int32_t>()
+        .with_device<kDLCUDA>(dev)
+        .verify(slot_expert_ids.value());
+  }
+
+  const int num_tokens = static_cast<int>(T.unwrap());
+  if (num_tokens == 0) return;
+
+  const DLDevice device = dev.unwrap();
+  const bool scores_bf16 = (host::dtype_bytes(topk_scores.dtype()) == 2);
+
+  const muse_spark::PostExpertFinalizeParams params{
+      .expert_output = expert_output.data_ptr(),
+      .norm_weight = norm_weight.has_value() ? norm_weight.value().data_ptr() : nullptr,
+      .topk_scores = topk_scores.data_ptr(),
+      .out = out.data_ptr(),
+      .slot_expert_ids = slot_expert_ids.has_value()
+          ? static_cast<const int32_t*>(slot_expert_ids.value().data_ptr())
+          : nullptr,
+      .eps = static_cast<float>(eps),
+      .num_tokens = num_tokens,
+      .scores_bf16 = scores_bf16,
+      .round_product = round_product,
+  };
+
+  const dim3 grid(static_cast<unsigned>(num_tokens));
+  LaunchKernel(grid, kNumThreads, device, 0)
+      .config({.use_pdl = kUsePDL})(
+          muse_spark::post_expert_finalize_kernel<kHidden, kNumThreads, kTopK, kNormMode, kUsePDL>,
+          params);
+}
+
+}  // namespace sglang
