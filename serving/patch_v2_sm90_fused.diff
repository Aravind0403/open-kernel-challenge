diff --git a/python/sglang/kernels/ops/moe/muse_spark_post_expert_finalize_jit.py b/python/sglang/kernels/ops/moe/muse_spark_post_expert_finalize_jit.py
new file mode 100644
index 00000000..7fbb44f1
--- /dev/null
+++ b/python/sglang/kernels/ops/moe/muse_spark_post_expert_finalize_jit.py
@@ -0,0 +1,176 @@
+"""Fused MuseSpark post-expert RMSNorm + active-slot combine (CUDA JIT).
+
+CUDA replacement for ``_post_expert_norm_weighted_sum_kernel`` in
+``sglang.kernels.ops.moe.muse_spark_post_expert_finalize_triton``. Uses
+warp-ballot pruning over ``slot_expert_ids >= 0``, fast zero-fill for tokens
+with zero local experts, ping-pong CTA reductions, and Programmatic Dependent
+Launch (PDL) on SM90+.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Optional
+
+import torch
+
+from sglang.kernels.jit.utils import (
+    cache_once,
+    is_arch_support_pdl,
+    load_jit,
+    make_cpp_args,
+)
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+_VEC = 8
+_THREAD_CHOICES = (256, 512, 1024, 128, 64, 32)
+
+
+def _select_num_threads(hidden: int) -> Optional[int]:
+    if hidden <= 0 or hidden % _VEC != 0:
+        return None
+    for threads in _THREAD_CHOICES:
+        if hidden % (threads * _VEC) == 0 and hidden // (threads * _VEC) <= 4:
+            return threads
+    for threads in _THREAD_CHOICES:
+        if hidden % (threads * _VEC) == 0:
+            return threads
+    return None
+
+
+def _select_norm_mode(
+    apply_norm: bool,
+    norm_weight: Optional[torch.Tensor],
+    weight_first: bool,
+) -> int:
+    if not apply_norm:
+        return 0
+    if norm_weight is None:
+        return 1
+    return 3 if weight_first else 2
+
+
+def is_jit_eligible(
+    expert_output: torch.Tensor,
+    topk_scores: torch.Tensor,
+    norm_weight: Optional[torch.Tensor] = None,
+    apply_norm: bool = True,
+    slot_expert_ids: Optional[torch.Tensor] = None,
+) -> bool:
+    """Return True if all tensor shapes, dtypes, and alignments match the CUDA JIT kernel."""
+    if (
+        not expert_output.is_cuda
+        or expert_output.dtype != torch.bfloat16
+        or expert_output.dim() != 3
+    ):
+        return False
+    tokens, topk, hidden = expert_output.shape
+    if (
+        tokens <= 0
+        or topk < 1
+        or topk > 32
+        or _select_num_threads(hidden) is None
+    ):
+        return False
+    if expert_output.is_contiguous() and expert_output.data_ptr() % 16 != 0:
+        return False
+    if (
+        topk_scores.device != expert_output.device
+        or topk_scores.shape != (tokens, topk)
+        or topk_scores.dtype not in (torch.float32, torch.bfloat16)
+    ):
+        return False
+    if apply_norm and norm_weight is not None:
+        if (
+            norm_weight.device != expert_output.device
+            or norm_weight.shape != (hidden,)
+            or norm_weight.dtype != torch.bfloat16
+        ):
+            return False
+        if norm_weight.is_contiguous() and norm_weight.data_ptr() % 16 != 0:
+            return False
+    if slot_expert_ids is not None:
+        if (
+            slot_expert_ids.device != expert_output.device
+            or slot_expert_ids.shape != (tokens, topk)
+            or slot_expert_ids.dtype not in (torch.int32, torch.int64)
+        ):
+            return False
+    return True
+
+
+@cache_once
+def _jit_module(
+    hidden: int,
+    num_threads: int,
+    topk: int,
+    norm_mode: int,
+) -> Module:
+    args = make_cpp_args(
+        hidden,
+        num_threads,
+        topk,
+        norm_mode,
+        is_arch_support_pdl(),
+    )
+    return load_jit(
+        "muse_spark_post_expert_finalize",
+        *args,
+        cuda_files=["muse_spark/post_expert_finalize.cuh"],
+        cuda_wrappers=[
+            (
+                "fused_post_expert_norm_weighted_sum",
+                f"fused_post_expert_norm_weighted_sum<{args}>",
+            )
+        ],
+    )
+
+
+def fused_post_expert_norm_weighted_sum_jit(
+    expert_output: torch.Tensor,
+    topk_scores: torch.Tensor,
+    norm_weight: Optional[torch.Tensor] = None,
+    eps: float = 1e-8,
+    weight_first: bool = True,
+    apply_norm: bool = True,
+    slot_expert_ids: Optional[torch.Tensor] = None,
+    round_product: bool = False,
+) -> torch.Tensor:
+    """Invoke the CUDA JIT post-expert finalize kernel on validated inputs."""
+    tokens, topk, hidden = expert_output.shape
+    num_threads = _select_num_threads(hidden)
+    assert num_threads is not None, f"Unsupported hidden dimension {hidden}"
+
+    x = expert_output if expert_output.is_contiguous() else expert_output.contiguous()
+    scores = topk_scores if topk_scores.is_contiguous() else topk_scores.contiguous()
+
+    norm_mode = _select_norm_mode(apply_norm, norm_weight, weight_first)
+    weight_in = None
+    if norm_mode >= 2 and norm_weight is not None:
+        weight_in = (
+            norm_weight if norm_weight.is_contiguous() else norm_weight.contiguous()
+        )
+
+    ids_in = None
+    if slot_expert_ids is not None:
+        ids_in = (
+            slot_expert_ids
+            if slot_expert_ids.dtype == torch.int32
+            else slot_expert_ids.to(torch.int32)
+        )
+        if not ids_in.is_contiguous():
+            ids_in = ids_in.contiguous()
+
+    out = torch.empty((tokens, hidden), dtype=torch.bfloat16, device=x.device)
+    module = _jit_module(hidden, num_threads, topk, norm_mode)
+    module.fused_post_expert_norm_weighted_sum(
+        x,
+        scores,
+        out,
+        weight_in,
+        ids_in,
+        float(eps),
+        bool(round_product),
+    )
+    return out
diff --git a/python/sglang/kernels/ops/moe/muse_spark_post_expert_finalize_triton.py b/python/sglang/kernels/ops/moe/muse_spark_post_expert_finalize_triton.py
